export LANG="en_US.UTF-8"

{{ if eq .chezmoi.os "linux" }}
export SHELL="/bin/bash"
{{ end }}

export EDITOR="hx"
alias helix=hx

export PAGER="less"

# Leave two cores free so the desktop stays responsive during Rust builds.
CARGO_BUILD_JOBS=$(( $(getconf _NPROCESSORS_ONLN) - 2 ))
[ "$CARGO_BUILD_JOBS" -lt 1 ] && CARGO_BUILD_JOBS=1
export CARGO_BUILD_JOBS

{{ if eq .chezmoi.os "linux" }}
export BROWSER="xdg-open"
{{ else if eq .chezmoi.os "darwin" }}
export BROWSER="open"
{{ end }}

# --- PATH CHANGES ---

# private bins
PATH="$HOME/bin:$HOME/.local/bin:$PATH"
PATH="$HOME/.cargo/bin:$PATH"
PATH="$HOME/go/bin:$PATH"

{{ if eq .chezmoi.os "darwin" | and (isExecutable "/opt/homebrew/bin/brew") }}
eval "$(/opt/homebrew/bin/brew shellenv)"

# TODO: remove these once builds are fixed in Albertine
export PATH="/opt/homebrew/opt/postgresql@15/bin:$PATH"
export PATH="/opt/homebrew/opt/openjdk/bin:$PATH"
{{ end }}

# Kache shims must come first so they intercept cc, c++ and cargo.
case "$PATH" in
    "$HOME/.local/lib/kache/shims"|"$HOME/.local/lib/kache/shims":*) ;;
    *) PATH="$HOME/.local/lib/kache/shims:$PATH" ;;
esac

export PATH

{{- $arch := get (dict "amd64" "X86_64" "arm64" "AARCH64") .chezmoi.arch }}
{{- $target := get (dict "linux" "UNKNOWN_LINUX_GNU" "darwin" "APPLE_DARWIN") .chezmoi.os }}
{{- if and $arch $target }}

# Kache paces test binaries so they wait for the CPU slots builds use.
[ -n "${CARGO_TARGET_{{ $arch }}_{{ $target }}_RUNNER-}" ] || export CARGO_TARGET_{{ $arch }}_{{ $target }}_RUNNER="kache test-runner"
{{- end }}
